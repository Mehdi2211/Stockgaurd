# Copy this file to .env and fill in your values
DATABASE_URL="postgresql://USER:PASSWORD@db.supabase.co:5432/postgres"
PORT=4000
FRONTEND_URL=http://localhost:3000
BCRYPT_ROUNDS=12
# Secret de signature des jetons JWT (obligatoire pour l'authentification API)
JWT_SECRET="change-me-long-random-string"
# Durée de vie des jetons (expiration courte : "2h", "12h", "1d")
JWT_EXPIRES_IN="12h"
# Mettre "require" pour forcer SSL (Supabase). Laisser vide pour une base locale sans SSL.
PGSSL=

# =====================================================================
# Crédits
# =====================================================================
# Plafond de crédit par créditeur, en DT (défaut 100). Jamais en dur côté
# frontend : le plafond est vérifié côté serveur à chaque dette.
CREDIT_LIMIT=100
# Si "true", la photo de la CIN est supprimée automatiquement quand le solde
# d'un créditeur retombe à 0 après un remboursement (défaut false).
CIN_AUTO_DELETE_ON_ZERO_BALANCE=false

# =====================================================================
# Stockage des photos de CIN — bucket Supabase Storage PRIVÉ (obligatoire
# pour créer un profil créditeur). JAMAIS de bucket public.
# =====================================================================
# URL du projet Supabase (https://xxxx.supabase.co)
SUPABASE_URL=
# Clé "service_role" (SECRÈTE — ne jamais l'exposer au frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Nom du bucket privé (créer le bucket avant utilisation, voir README)
SUPABASE_CIN_BUCKET=cin-photos

# =====================================================================
# Emails de notification (nodemailer) — AUCUNE vraie valeur ici.
# Le SMTP n'est pas obligatoire : sans lui, les notifications restent en
# attente dans `notification_outbox` (aucune tentative consommée).
# =====================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur (ex. "StockGuard <no-reply@mondomaine.tn>")
MAIL_FROM=
# Intervalle du worker de reprise des notifications, en ms (défaut 60000)
NOTIFY_RETRY_INTERVAL_MS=60000

# =====================================================================
# Exemples de fournisseurs SMTP (à saisir dans les variables ci-dessus)
# =====================================================================
# Gmail   : SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USER=<gmail>
#           SMTP_PASS=<mot de passe d'application>   (2FA requis)
# Brevo   : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>
#           SMTP_PASS=<clé SMTP>
# Resend  : SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend
#           SMTP_PASS=<clé API>
